# polymm - environment variables
# Copy this file to `.env` and fill in your own values. Never commit `.env`.

# ── Polymarket (required for trading) ────────────────────────────────
# Your Polymarket wallet. The CLOB API credentials (key/secret/passphrase)
# are derived from the private key automatically on startup.
POLYMARKET_PRIVATE_KEY=your_private_key_here
POLYMARKET_FUNDER_ADDRESS=your_funder_address_here
POLYMARKET_SIGNATURE_TYPE=2

# ── Odds source (required) ───────────────────────────────────────────
# Sign up for a key at https://the-odds-api.com
THE_ODDS_API_KEY=your_the_odds_api_key

# ── Supabase (required) ──────────────────────────────────────────────
# The bot reads aggregated odds from Supabase and logs fills/positions to it.
# Table schema lives in sql/.
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_supabase_service_key

# ── Telegram alerts (optional) ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id

# ── Optional / advanced ──────────────────────────────────────────────
# A second wallet address, used only by the analytics scripts.
# POLYMARKET_FUNDER_ADDRESS_LIVE=your_second_funder_address
# Feature flag: also quote tennis doubles markets (default off).
# TRADE_TENNIS_DOUBLES=0
